{
  "manifest_version": 3,
  "name": "PUPSync",
  "version": "0.1.0",
  "description": "Import PUP SIAS class schedule into Google Calendar",
  "permissions": ["identity", "storage", "scripting", "activeTab"],
  "host_permissions": [
    "*://*.pup.edu.ph/*",
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "958137803937-7rd7gjhuba0b1ghachm9sk44flfokqc3.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/calendar.events"]
  },
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.pup.edu.ph/student/schedule*"],
      "js": [
        "shared/constants.js",
        "shared/utils.js",
        "shared/semester-config.js",
        "content/page-scrape.js",
        "content/parser.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "PUPSync",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["config/academic-calendar.csv"],
      "matches": ["*://*.pup.edu.ph/*"]
    }
  ]
}
